programa
{
	
	funcao inicio()
	{
		//3) Escreva um algoritmo para imprimir os 10 primeiros números inteiros maiores que 100.
		inteiro numero=101

		enquanto (numero < 111){
		escreva(numero," ")
		numero++
		}
	}
}
