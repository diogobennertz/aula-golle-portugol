programa
{
	
	funcao inicio()
	{
	//2) Escreva um algoritmo para imprimir os números de 1 (inclusive) a 10  (inclusive) em ordem decrescente.
	inteiro numero=10
	enquanto (numero > 0){
		escreva(numero," ")
		numero--
	}
	
	}
}

