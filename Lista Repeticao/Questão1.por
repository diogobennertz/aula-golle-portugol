programa
{
	
	funcao inicio()
	{
	//1) Escreva um algoritmo para imprimir os números de 1 (inclusive) a 10  (inclusive) em ordem crescente.
	inteiro numero=0
	enquanto (numero <11){
		escreva(numero," ")
		numero++
	}
	
	}
}

